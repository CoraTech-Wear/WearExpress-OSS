<template>
  <div @swipe="returnHome">
    <image src="/common/Images/about/bg.png" style="position: absolute;top: 0;left: 0;"></image>
    <div class="TitleBar">
      <text class="time">{{ currentTime }}</text>
      <text class="titleText">关于</text>
    </div>
    <scroll class="scroll" scroll-y="true" bounces="true">
      <image src="/common/Images/about/about.png"></image>
    </scroll>
  </div>
</template>

<script>
import {updateTime} from "../../common/commons"

export default {
  private: {
    currentTime: "",
  },
  onInit() {
    this.updateTime()
    setInterval(() => {
      this.updateTime()
    }, 60000)
  },
  updateTime() {
    this.currentTime = updateTime()
  },
  returnHome() {
    router.replace({
      uri: "pages/home"
    }) 
  }
}
</script>

